# Frontend environment. Vite only exposes variables prefixed with VITE_ to the bundle, so
# everything here ships to the browser — never put a secret in this file.

# Backend origin. In dev, vite.config.js proxies /api to VITE_API_PROXY_TARGET instead.
# VITE_API_BASE_URL=/api

# Dev-only proxy target for /api and /socket.io. Defaults to http://127.0.0.1:5000.
# Deliberately does NOT fall back to VITE_BACKEND_URL, so `npm run dev` never silently
# proxies to staging.
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# --- Crash reporting (Sentry) --------------------------------------------------------------
#
# Leave unset and src/utils/observability.js is fully inert: no init, no network, no behaviour
# change. That is the intended state for local dev and the test suite.
#
# With it set, a render crash caught by ErrorBoundary is reported automatically. That is the
# gap that let two ReferenceErrors ship unnoticed — `CardElement` in Raise.jsx, which broke
# card donations, and `DIGPROD_CATS` in DigitalProducts.jsx, which blanked the page.
#
# This DSN is public by design (it is in the bundle); it only permits writing events.
# Payloads are scrubbed before send: every URL query value is redacted (session handoff uses
# ?token=), auth headers and credential fields are stripped, console breadcrumbs are dropped,
# and the user is identified by account id only.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Environment label in the Sentry UI. Falls back to Vite's MODE.
# VITE_APP_ENV=

# Release identifier, so a crash can be tied to a deploy. Usually the commit SHA.
# VITE_APP_RELEASE=

# Performance tracing is OFF by default (0). Raise deliberately, e.g. 0.05 for 5% of sessions.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
