# Screenshots and debug scripts (generated during development/testing)
*.png
*.jpeg
*.jpg
*.mp4
# Never commit build/upload artifacts. A stray "*-app.zip" (13MB, with a Windows-
# illegal ".\" path) slipped into #1378 and broke `git pull` on Windows — see bug #488.
*.zip
debug_*.cjs
test-quote-*.cjs
scratch_*.cjs
test-results/
.claude/worktrees/
.worktrees/
.claude/settings.json
.claude/settings.local.json
VIDEO_CHECKLIST.md

# Markdown — ignore all (CLAUDE.md, plans, scratch, audit notes) EXCEPT READMEs
*.md
!README.md
!**/README.md
fill-cognate-log.txt

# Local git worktrees (never part of the repo).
_worktrees/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
config.bat
